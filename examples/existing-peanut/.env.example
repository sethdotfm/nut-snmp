# Credentials upsd will accept. PeaNUT authenticates with these, so whatever you
# set here must match the USERNAME/PASSWORD in PeaNUT's settings.yml.
NUT_USER=nutmon
NUT_PASSWORD=change-me

# Or, with Docker secrets, drop NUT_PASSWORD and point at the mounted file:
# NUT_PASSWORD_FILE=/run/secrets/nut_password

# upsd bind address. 0.0.0.0 is fine here: the port is published to the compose
# networks only, never to the LAN.
LISTEN_ADDR=0.0.0.0
LISTEN_PORT=3493

# How long data may go unrefreshed before upsd calls it stale (seconds).
# NUT's default is 15, which suits SNMP polling; raise it only if you have
# pushed pollfreq well above the default 30.
# MAXAGE=15
