{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "ups-overview"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "grafana",
            "version": "v0",
            "datasource": {
              "name": "-- Grafana --"
            },
            "spec": {}
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "builtIn": true
        }
      }
    ],
    "cursorSync": "Tooltip",
    "editable": true,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Power Source | View Details",
          "description": "",
          "links": [
            {
              "title": "Show details",
              "url": "/d/ups-detail/ups-detail?var-ups=${ups:percentencode}&${__url_time_range}"
            }
          ],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "(\n  time() - max_over_time(timestamp(network_ups_tools_ups_status{ups=\"$ups\", flag=\"OL\"} == 0)[24h:1m])\n  or\n  time() - min_over_time(timestamp(network_ups_tools_ups_status{ups=\"$ups\", flag=\"OL\"})[24h:1m])\n)\nand on(ups) (network_ups_tools_ups_status{ups=\"$ups\", flag=\"OL\"} == 1)",
                        "instant": true,
                        "legendFormat": "On line for:",
                        "range": false
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "editorMode": "code",
                        "exemplar": false,
                        "expr": "(\n  max_over_time(timestamp(network_ups_tools_ups_status{ups=\"$ups\", flag=\"OL\"} == 1)[24h:1m]) - time()\n  or\n  min_over_time(timestamp(network_ups_tools_ups_status{ups=\"$ups\", flag=\"OL\"})[24h:1m]) - time()\n)\nand on(ups) (network_ups_tools_ups_status{ups=\"$ups\", flag=\"OL\"} == 0)",
                        "instant": true,
                        "legendFormat": "On battery for:",
                        "range": false
                      }
                    },
                    "refId": "C",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.2.1",
            "spec": {
              "options": {
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "center",
                "orientation": "auto",
                "percentChangeColorMode": "standard",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showPercentChange": false,
                "text": {
                  "titleSize": 40,
                  "valueSize": 40
                },
                "textMode": "value_and_name",
                "wideLayout": true
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "dthms",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "red"
                      },
                      {
                        "value": 0,
                        "color": "green"
                      }
                    ]
                  },
                  "color": {
                    "mode": "thresholds"
                  },
                  "noValue": "NO DATA"
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byFrameRefID",
                      "options": "B"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "On line for:"
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byFrameRefID",
                      "options": "C"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "On battery for:"
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Battery Charge",
          "description": "",
          "links": [],
